# ─────────────────────────────────────────────────────────────────────────────
# Salin ke .env lalu isi bagian bertanda ▼ .
# .env ada di .gitignore — jangan pernah di-commit.
# Key yang bocor ke repo publik akan dicabut panitia. [SUBMISSION.md §2]
# ─────────────────────────────────────────────────────────────────────────────

# ▼ Dari sectors.app → API Keys (butuh plan Insider).
SECTORS_API_KEY=isi_di_sini

# ▼ Penyedia LLM: "claude" atau "minimax". Bisa ditukar tanpa ubah kode.
PANTAU_LLM_PROVIDER=claude

# ▼ Dari console.anthropic.com → API Keys. Isi kalau provider = claude.
ANTHROPIC_API_KEY=isi_di_sini

# ▼ Dari platform.minimax.io → API Keys. Isi kalau provider = minimax.
#   MiniMax M3 Anthropic-compatible: SDK sama, cuma base_url dan model beda.
#   https://platform.minimax.io/docs/api-reference/text-anthropic-api
MINIMAX_API_KEY=isi_di_sini


# ── Di bawah ini sudah terisi. Ubah hanya kalau tahu kenapa. ─────────────────
SECTORS_REST_BASE=https://api.sectors.app/v2
SECTORS_MCP_URL=https://sectors-mcp.supertype.ai/mcp

MINIMAX_BASE_URL=https://api.minimax.io/anthropic

# Model per penyedia. *_EVAL dipakai eval berulang supaya murah. [K9]
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MODEL_EVAL=claude-haiku-4-5-20251001
MINIMAX_MODEL=MiniMax-M3
MINIMAX_MODEL_EVAL=MiniMax-M2.7-highspeed

# Pagar agen. Diubah hanya lewat contracts/CHANGES.md. [AD-6]
PANTAU_MAX_STEPS=8
PANTAU_MAX_CREDITS=25
